{
	"compilerOptions": {
		"baseUrl": "src",
		"module": "commonjs",
		"target": "ES2022",
		"outDir": "build",
		"lib": [
			"ES2022",
			"dom"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true
	},
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
